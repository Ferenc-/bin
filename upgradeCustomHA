#!/usr/bin/env bash

PREFIX="${HOME}/github.com"

for i in "${PREFIX}"/ha-parcel-integrations/* "${PREFIX}"/mampfes/*; do
  printf "%s: " "$(basename ${i})"
  pushd "${i}" >/dev/null || exit
  git fetch --all && git remote prune origin
  git tag --list --sort=-version:refname | awk '/^v?[0-9]+\.[0-9]+\.[0-9]+$/{ print; exit }'
  popd >/dev/null || exit
  scp -qr "${i}" Malna:/tmp/
done
